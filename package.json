{
  "name": "@coreplane/repo-lore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "public",
    "test",
    "scripts",
    "tsconfig*.json",
    "bun.lock",
    "README.md",
    "METHOD.md",
    "RESEARCH.md",
    "VALIDATION.md",
    "THIRD_PARTY.md",
    "wrangler.json",
    "DEPLOYMENT.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "report": "node scripts/report.mjs",
    "prepublishOnly": "node scripts/refuse-publish.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coreplanelabs/repolore.git"
  },
  "homepage": "https://repolore.fun"
}

{
  "name": "@coreplane/repo-lore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src",
    "public",
    "test",
    "scripts",
    "tsconfig*.json",
    "bun.lock",
    "README.md",
    "METHOD.md",
    "RESEARCH.md",
    "VALIDATION.md",
    "THIRD_PARTY.md",
    "wrangler.json",
    "DEPLOYMENT.md",
    "LICENSE",
    "server",
    "worker",
    "tsconfig.server.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node scripts/clean.mjs --tests && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.server.json && node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "report": "node scripts/report.mjs",
    "prepublishOnly": "node scripts/refuse-publish.mjs",
    "capture": "node scripts/capture.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3",
    "wrangler": "4.148.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coreplanelabs/repolore.git"
  },
  "homepage": "https://repolore.fun",
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  }
}

{
  "name": "repo-lore",
  "account_id": "3c7b28f23cc93f09e77bb0a9ffcb7e6f",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "repolore.fun",
      "custom_domain": true,
      "zone_id": "618fed6a003533063757ddf6ab517bac"
    }
  ],
  "main": "worker/entry.ts",
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      "id": "5ce3d8b4fad240a89542b35c99ea9153"
    }
  ],
  "limits": {
    "cpu_ms": 1000
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
